    <style>
        .loader-wrapper {
            position: fixed;
            z-index: 999999999;
            background: rgba(41, 43, 55, 0.85);
            width: 100%;
            height: 100vh;
            top: 0;
            left: 0;
        }

        .loading-div {
            position: relative;
            width: 70px;
            height: 34px;
            margin: 50px auto;
            transform: scale(1.6);
            top: 35%;
        }

            .loading-div span, .loading-div p {
                offset-path: path("M67.3,17.8c0-9.3-4.8-14.5-13.8-14.5C41.9,3.2,35.7,17,35.7,17s-6.2,13.8-17.8,13.8C10,30.8,4,25.5,4,17.7 C4, 9.6, 10, 3.2, 17.8, 3.2C29.4, 3.2, 35.7, 17, 35.7, 17s6.2, 13.8, 17.8, 13.8C61.4, 30.8, 67.3, 24.8, 67.3, 17.8z");
                position: absolute;
            }

            .loading-div span {
                color: #fff;
                font-size: 12px;
                animation: path 1.4s linear infinite;
            }

            .loading-div p {
                width: 5px;
                height: 5px;
                border-radius: 50%;
                opacity: 0;
                motion-rotation: auto 45deg;
                background: #fff;
                animation: path 1.4s linear infinite, dot linear forwards;
            }

                .loading-div p:nth-of-type(1) {
                    background: #bf4040;
                    animation-delay: 0.015s;
                }

                .loading-div p:nth-of-type(2) {
                    background: #bf5540;
                    animation-delay: 0.03s;
                }

                .loading-div p:nth-of-type(3) {
                    background: #bf6a40;
                    animation-delay: 0.045s;
                }

                .loading-div p:nth-of-type(4) {
                    background: #bf8040;
                    animation-delay: 0.06s;
                }

                .loading-div p:nth-of-type(5) {
                    background: #bf9540;
                    animation-delay: 0.075s;
                }

                .loading-div p:nth-of-type(6) {
                    background: #bfaa40;
                    animation-delay: 0.09s;
                }

                .loading-div p:nth-of-type(7) {
                    background: #bfbf40;
                    animation-delay: 0.105s;
                }

                .loading-div p:nth-of-type(8) {
                    background: #aabf40;
                    animation-delay: 0.12s;
                }

                .loading-div p:nth-of-type(9) {
                    background: #95bf40;
                    animation-delay: 0.135s;
                }

                .loading-div p:nth-of-type(10) {
                    background: #80bf40;
                    animation-delay: 0.15s;
                }

                .loading-div p:nth-of-type(11) {
                    background: #6abf40;
                    animation-delay: 0.165s;
                }

                .loading-div p:nth-of-type(12) {
                    background: #55bf40;
                    animation-delay: 0.18s;
                }

                .loading-div p:nth-of-type(13) {
                    background: #40bf40;
                    animation-delay: 0.195s;
                }

                .loading-div p:nth-of-type(14) {
                    background: #40bf55;
                    animation-delay: 0.21s;
                }

                .loading-div p:nth-of-type(15) {
                    background: #40bf6a;
                    animation-delay: 0.225s;
                }

                .loading-div p:nth-of-type(16) {
                    background: #40bf80;
                    animation-delay: 0.24s;
                }

                .loading-div p:nth-of-type(17) {
                    background: #40bf95;
                    animation-delay: 0.255s;
                }

                .loading-div p:nth-of-type(18) {
                    background: #40bfaa;
                    animation-delay: 0.27s;
                }

                .loading-div p:nth-of-type(19) {
                    background: #40bfbf;
                    animation-delay: 0.285s;
                }

                .loading-div p:nth-of-type(20) {
                    background: #40aabf;
                    animation-delay: 0.3s;
                }

                .loading-div p:nth-of-type(21) {
                    background: #4095bf;
                    animation-delay: 0.315s;
                }

                .loading-div p:nth-of-type(22) {
                    background: #4080bf;
                    animation-delay: 0.33s;
                }

                .loading-div p:nth-of-type(23) {
                    background: #406abf;
                    animation-delay: 0.345s;
                }

                .loading-div p:nth-of-type(24) {
                    background: #4055bf;
                    animation-delay: 0.36s;
                }

                .loading-div p:nth-of-type(25) {
                    background: #4040bf;
                    animation-delay: 0.375s;
                }

                .loading-div p:nth-of-type(26) {
                    background: #5540bf;
                    animation-delay: 0.39s;
                }

                .loading-div p:nth-of-type(27) {
                    background: #6a40bf;
                    animation-delay: 0.405s;
                }

                .loading-div p:nth-of-type(28) {
                    background: #8040bf;
                    animation-delay: 0.42s;
                }

                .loading-div p:nth-of-type(29) {
                    background: #9540bf;
                    animation-delay: 0.435s;
                }

                .loading-div p:nth-of-type(30) {
                    background: #aa40bf;
                    animation-delay: 0.45s;
                }

                .loading-div p:nth-of-type(31) {
                    background: #bf40bf;
                    animation-delay: 0.465s;
                }

                .loading-div p:nth-of-type(32) {
                    background: #bf40aa;
                    animation-delay: 0.48s;
                }

                .loading-div p:nth-of-type(33) {
                    background: #bf4095;
                    animation-delay: 0.495s;
                }

                .loading-div p:nth-of-type(34) {
                    background: #bf4080;
                    animation-delay: 0.51s;
                }

                .loading-div p:nth-of-type(35) {
                    background: #bf406a;
                    animation-delay: 0.525s;
                }

        @keyframes path {
            to {
                offset-distance: 100%;
            }
        }

        @keyframes dot {
            to {
                opacity: 1;
            }
        }
    </style>
</head>
<body>
    <form id="form1" runat="server">
        <asp:ToolkitScriptManager runat="server" EnablePageMethods="true"></asp:ToolkitScriptManager>
        <!-- Navbar -->
        <nav class="navbar navbar-light custBgLight">
            <div class="headSection">
                <div class="leftDtls">
                    <div class="bLogoBIconBg">
                        <a href="Home.aspx" title="Home" style="display: flex; justify-content: flex-start; width: 100%;">
                            <img id="logo" class="bLogo" src="images/logo-new.jpg" alt="Best Wall Paint Colors, House Painting Colors" title="Berger Paints" />
                        </a>
                        <button type="button" id="sidebarCollapse" class="btn btn-light humMenuIcon">
                            <i class="fa fa-bars"></i>
                        </button>
                    </div>
                    <div class="nameDtlsList">
                        <h4 class="vmsName">Vendor Management System</h4>
                        <ul class="userDtls">
                            <li>Company:<asp:Label ID="lblCompany" runat="server"></asp:Label></li>
                            <li>Region:<asp:Label ID="lblRegion" runat="server"></asp:Label></li>
                            <li>Depot:<asp:Label ID="lblDepot" runat="server"></asp:Label></li>
                        </ul>
                    </div>
                </div>
                <div class="rightDtls">
                    <div class="userNamePic dropdown">
                        <img class="userPic" src="images/avatar-no-img.png" alt="Img" />
                        <div class="userNameCatg dropdown-toggle" data-toggle="dropdown">
                            <h3 class="userName">
                                <asp:Label ID="lblUserName" runat="server"></asp:Label></h3>
                            <p class="userCatg">
                                <asp:Label ID="lblUserGroup" runat="server"></asp:Label>
                            </p>
                        </div>
                        <div class="dropdown-menu">
                            <a class="dropdown-item" href="User_help.html" target="_blank" title="Click to view System Help Guide">User Guide</a>
                            <a class="dropdown-item" href="Contacts.html" target="_blank" title="Contact Us">Contact Us</a>
                            <a class="dropdown-item" href="Faqs_info.html" target="_blank" title="FAQ">FAQ's</a>
                            <a class="dropdown-item SignoutLink" href="Logout_New.aspx" title="Sign Out">Sign Out</a>
                        </div>
                        <span id="reg_marquee_scroll" runat="server" style="display: none;">&nbsp;</span>
                    </div>
                </div>
            </div>
        </nav>

        <!-- Sidebar -->
        <nav id="sidebar" class="sideNavBarView <%= If(HideSidebar, "active", "") %>">
            <div class="sidebar-header">
                <h4 class="menuTx">Menu</h4>
            </div>
            <asp:Literal ID="_clientScript" runat="server"></asp:Literal>
        </nav>

        <!-- Page Content -->
        <div id="content" class="contentMainBody">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder>

            <asp:UpdateProgress ID="updProgress" runat="server" DisplayAfter="0">
                <ProgressTemplate>
                    <div class="pageLoader">
                        <div class="innerLoader">
                            <%--<img class="loaderImg" alt="progress" src="images/ajax-loader.gif" />
                            <p class="loaderTx">Processing... Please Wait.</p>--%>
                            <div class="loader-wrapper">
                                <div class="loading-div">
                                    <span></span>
                                    <p></p>
                                    <p></p>
                                    <p></p>
                                    <p></p>
                                    <p></p>
                                    <p></p>
                                    <p></p>
                                    <p></p>
                                    <p></p>
                                    <p></p>
                                    <p></p>
                                    <p></p>
                                    <p></p>
                                    <p></p>
