<%@ Master Language="VB" AutoEventWireup="false" CodeFile="MasterPage.master.vb" Inherits="MasterPage" %>

<%@ Register Assembly="AjaxControlToolkit" Namespace="AjaxControlToolkit" TagPrefix="asp" %>

<!doctype html>
<html lang="en">
<head runat="server" id="head">
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>:: Welcome to Vendor Management System ::</title>
    <link rel="shortcut icon" href="images/favicon.png" type="image/x-icon" />
    <link href="includes/style.css?v=1.0.0.<%= DateTime.Now.Ticks.ToString() %>" rel="stylesheet" type="text/css" />
    <link href="includes/bootstrap.min.css" rel="stylesheet" type="text/css" />

    <script type="text/javascript" src="Scripts/anchorposition.js"></script>
    <script type="text/javascript" src="Scripts/csspopup.js"></script>
    <script type="text/javascript" src="Scripts/popupwindow.js"></script>
    <script type="text/javascript" src="Scripts/calendarpopup.js"></script>
    <script type="text/javascript" src="Scripts/date.js"></script>
    <script type="text/javascript" src="Scripts/Currency.js"></script>
    <%--    <script type="text/javascript" src="Scripts/FunctionValidator.js"></script>--%>
    <script type="text/javascript">
        // Modified-by MUKESH BHAGAT on 31-08-2026 : fnNewWindow used to come from
        // FunctionValidator.js (commented out above); several pages open reports through it
        // from code-behind and were failing silently. Defined here as a fallback - a page
        // (or red.js) that declares its own fnNewWindow later still overrides this one.
        window.fnNewWindow = function (strUrl, strtarget) {
            window.open(strUrl, strtarget, "status=no,toolbar=no,menubar=no,location=no,scrollbars=yes,modal=yes,resizable=yes");
        };
    </script>
    <script type="text/javascript" src="Scripts/Messages.js"></script>
    <script type="text/javascript" src="Scripts/RegEX.js"></script>
    <script type="text/javascript" src="Scripts/AjaxServices.js"></script>
    <script type="text/javascript" src="Scripts/Autocomplete.js"></script>
    <script type="text/javascript" src="Scripts/vmsAutoCompleteUI.js"></script>

    <link type="text/css" rel="Stylesheet" href="includes/select2.min.css" />
    <link type="text/css" rel="Stylesheet" href="includes/select2-bootstrap4.min.css" />
    <link href="includes/sumoselect.css" rel="stylesheet" />

    <!-- JS -->
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>

    <link href="includes/upgrad-style.css?v=1.0.0.<%= DateTime.Now.Ticks.ToString() %>" rel="stylesheet" type="text/css" />
</head>
<body>
    <form id="form1" runat="server">
        <asp:ToolkitScriptManager runat="server"></asp:ToolkitScriptManager>
        <!-- Navbar -->
        <nav class="navbar navbar-light custBgLight">
            <div class="headSection">
                <div class="leftDtls">
                    <div class="bLogoBIconBg">
                        <a href="Home.aspx" title="Home" style="display: flex; justify-content: flex-start; width: 100%;">
                            <img id="logo" class="bLogo" src="images/logo-rbr.png" alt="Best Wall Paint Colors, House Painting Colors" title="Berger Paints" />
                        </a>
                        <button type="button" id="sidebarCollapse" class="btn btn-light humMenuIcon">
                            <i class="fa fa-bars"></i>
                        </button>
                    </div>
                    <div class="nameDtlsList">
                        <h4 class="vmsName">Vendor Management System</h4>
                        <ul class="userDtls">
                            <li>Company:<asp:Label ID="lblCompany" runat="server"></asp:Label></li>
                            <li>Region:<asp:Label ID="lblRegion" runat="server"></asp:Label></li>
                            <li>Depot:<asp:Label ID="lblDepot" runat="server"></asp:Label></li>
                        </ul>
                    </div>
                </div>
                <div class="rightDtls">
                    <div class="userNamePic dropdown">
                        <img class="userPic" src="images/avatar-no-img.png" alt="Img" />
                        <div class="userNameCatg dropdown-toggle" data-toggle="dropdown">
                            <h3 class="userName">
                                <asp:Label ID="lblUserName" runat="server"></asp:Label></h3>
                            <p class="userCatg">
                                <asp:Label ID="lblUserGroup" runat="server"></asp:Label>
                            </p>
                        </div>
                        <div class="dropdown-menu">
                            <a class="dropdown-item" href="User_help.html" target="_blank" title="Click to view System Help Guide">User Guide</a>
                            <a class="dropdown-item" href="Contacts.html" target="_blank" title="Contact Us">Contact Us</a>
                            <a class="dropdown-item" href="Faqs_info.html" target="_blank" title="FAQ">FAQ's</a>
                            <a class="dropdown-item SignoutLink" href="Logout_New.aspx" title="Sign Out">Sign Out</a>
                        </div>
                        <span id="reg_marquee_scroll" runat="server" style="display: none;">&nbsp;</span>
                    </div>
                </div>
            </div>
        </nav>

        <!-- Sidebar -->
        <nav id="sidebar" class="sideNavBarView <%= If(HideSidebar, "active", "") %>">
            <div class="sidebar-header">
                <h4 class="menuTx">Menu</h4>
            </div>
            <asp:Literal ID="_clientScript" runat="server"></asp:Literal>
        </nav>

        <!-- Page Content -->
        <div id="content" class="contentMainBody">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder>

            <asp:UpdateProgress ID="updProgress" runat="server" DisplayAfter="0">
                <ProgressTemplate>
                    <div class="pageLoader">
                        <div class="innerLoader">
                            <img class="loaderImg" alt="progress" src="images/ajax-loader.gif" />
                            <p class="loaderTx">Processing... Please Wait.</p>
                        </div>
                    </div>
                </ProgressTemplate>
            </asp:UpdateProgress>
        </div>
    </form>

    <script type="text/javascript" src="Scripts/select2.full.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            //Initialize Select2 Elements
            $('.select2').select2();
        });
        var prm = Sys.WebForms.PageRequestManager.getInstance();
        prm.add_endRequest(function () {
            $('.select2').select2();
        });
    </script>
    <script>
        $(document).ready(function () {
            $('#sidebarCollapse').on('click', function () {
                $('#sidebar').toggleClass('active');
            });
        });
    </script>
    <!-- Left menu behaviour: one main menu open at a time + active (selected) menu highlight -->
    <script type="text/javascript">
        (function ($) {
            if (!$) { return; }

            var SIDEBAR = '#sidebar';
            var MENU = '#sidebar ul.collapse';
            var STORE_KEY = 'vmsSidebarOpenMenu';

            // File name part of a url, used to match a menu link with the current page
            function pageOf(url) {
                if (!url) { return ''; }
                var s = String(url).split('#')[0].split('?')[0];
                return s.substring(s.lastIndexOf('/') + 1).toLowerCase();
            }

            function store(id) {
                try { window.sessionStorage.setItem(STORE_KEY, id || ''); } catch (e) { }
            }

            function stored() {
                try { return window.sessionStorage.getItem(STORE_KEY) || ''; } catch (e) { return ''; }
            }

            // Expand a submenu without animation (page load only)
            function expand($ul) {
                if (!$ul || !$ul.length) { return; }
                $ul.addClass('show');
                $ul.prev('a.dropdown-toggle').attr('aria-expanded', 'true').addClass('active');
            }

            // Collapse every other main menu
            function closeOthers(el) {
                $(SIDEBAR).find('ul.collapse.show').each(function () {
                    if (this !== el) { $(this).collapse('hide'); }
                });
            }

            // Find the menu entry of the current page, expand + highlight it
            function applyState() {
                var $sidebar = $(SIDEBAR);
                if (!$sidebar.length) { return; }

                var current = pageOf(window.location.pathname);
                var $match = $();

                if (current) {
                    $sidebar.find('ul.components a[href]').each(function () {
                        var $a = $(this);
                        if ($a.hasClass('dropdown-toggle')) { return; }
                        if (pageOf($a.attr('href')) === current) {
                            $match = $a;
                            return false;
                        }
                    });
                }

                if ($match.length) {
                    $match.addClass('active');
                    var $parent = $match.closest('ul.collapse');
                    expand($parent);
                    store($parent.length ? ($parent.attr('id') || '') : '');
                    return;
                }

                // Page is not a menu entry itself (detail / child screen):
                // keep the main menu the user came from expanded.
                var last = stored();
                if (last) {
                    expand($sidebar.find('ul.collapse').filter(function () { return this.id === last; }));
                }
            }

            var $doc = $(document);

            // Expanding a main menu collapses the others and makes it the active one
            $doc.on('show.bs.collapse', MENU, function () {
                closeOthers(this);
                $(SIDEBAR).find('a.dropdown-toggle').removeClass('active');
                $(this).prev('a.dropdown-toggle').addClass('active');
                store($(this).attr('id') || '');
            });

            // Safety net for rapid clicks: a menu that finished opening late is closed here
            $doc.on('shown.bs.collapse', MENU, function () {
                closeOthers(this);
            });

            $doc.on('hide.bs.collapse', MENU, function () {
                $(this).prev('a.dropdown-toggle').removeClass('active');
            });

            // Clicking a page link keeps its main menu expanded + active
            $doc.on('click', '#sidebar ul.components a', function () {
                var $a = $(this);
                if ($a.hasClass('dropdown-toggle')) { return; }

                var $sidebar = $(SIDEBAR);
                $sidebar.find('ul li a').not('.dropdown-toggle').not($a).removeClass('active');
                $a.addClass('active');

                var $parent = $a.closest('ul.collapse');
                store($parent.length ? ($parent.attr('id') || '') : '');
                if ($parent.length) {
                    $sidebar.find('a.dropdown-toggle').removeClass('active');
                    $parent.prev('a.dropdown-toggle').addClass('active');
                }
            });

            $(function () {
                applyState();

                // Re-apply only if an async postback re-rendered the sidebar
                if (typeof Sys !== 'undefined' && Sys.WebForms && Sys.WebForms.PageRequestManager) {
                    Sys.WebForms.PageRequestManager.getInstance().add_endRequest(function () {
                        if ($(SIDEBAR).find('ul.collapse.show').length === 0) { applyState(); }
                    });
                }
            });
        })(window.jQuery);
    </script>
</body>
</html>
